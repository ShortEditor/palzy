rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ──────────────────────────────────────────────
    function isAuth()    { return request.auth != null; }
    function uid()       { return request.auth.uid; }
    function isAdmin()   {
      return isAuth() &&
        get(/databases/$(database)/documents/users/$(uid())).data.isAdmin == true;
    }
    function isBanned() {
      return isAuth() &&
        get(/databases/$(database)/documents/users/$(uid())).data.get('banned', false) == true;
    }

    // Accept both student-number formats for college 170. Format does not prove enrollment.
    function validCollegePin(data) {
      return data.get('collegePin', null) is string &&
        data.collegePin.matches('^[0-9]{2}170(-(CM|CS|EC)-[0-9]{3}|(CM|CS|EC)[0-9]{3})$');
    }
    function validChangedCollegePin() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['collegePin']) ||
        validCollegePin(request.resource.data);
    }

    // Video posts are admin-only (single account). Posts without video fields are unaffected.
    // Rollback: delete this function and the `&& videoPostAllowed()` line in /posts create.
    function videoPostAllowed() {
      return !(request.resource.data.keys().hasAny(['videoURL', 'videoDuration']) ||
               request.resource.data.get('type', '') == 'video') ||
        (isAdmin() && request.auth.token.email == 'shorteditor4@gmail.com');
    }

    // ─── Users ────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isAuth();

      // Helper: rejects any write that touches privilege-escalation fields.
      // isAdmin, isVerified, banned can ONLY be written by an existing admin
      // via the admin panel (which calls setUserAdmin / setUserBanned).
      // Regular users and the auth flow can never set these.
      function noPrivilegedFields() {
        let prohibited = ['isAdmin', 'isVerified', 'banned'];
        return !request.resource.data.keys().hasAny(prohibited) &&
          request.resource.data.get('followerCount', 0) == 0 &&
          request.resource.data.get('followingCount', 0) == 0;
      }

      function noPrivilegedFieldsChanged() {
        let prohibited = ['isAdmin', 'isVerified', 'banned', 'followerCount', 'followingCount'];
        return !request.resource.data.diff(resource.data).affectedKeys().hasAny(prohibited);
      }

      // User can create their own document — privileged fields forbidden entirely
      allow create: if isAuth()
        && uid() == userId
        && noPrivilegedFields()
        && validCollegePin(request.resource.data);

      // User can update their own document — cannot touch privileged fields
      allow update: if isAuth()
        && uid() == userId
        && noPrivilegedFieldsChanged()
        && validChangedCollegePin();

      // Admin can update anything on any user document
      // (isAdmin() reads from Firestore itself so a user cannot fake it client-side)
      allow update: if isAdmin();
    }


    // ─── Posts ────────────────────────────────────────────────
    match /posts/{postId} {
      allow read:   if isAuth();
      allow create: if isAuth() && !isBanned()
        && videoPostAllowed()
        && request.resource.data.authorId == uid()
        && request.resource.data.get('likeCount', 0) == 0
        && request.resource.data.get('commentCount', 0) == 0
        && request.resource.data.get('emojiCounts', {}) == {};
      allow delete: if isAuth()
        && (resource.data.authorId == uid() || isAdmin());
      // Counts are derived from likes/comments, never client-written aggregates.
      allow update: if false;

      // ─── Comments (subcollection) ────────────────────────
      match /comments/{commentId} {
        allow read:   if isAuth();
        allow create: if isAuth() && !isBanned()
          && request.resource.data.authorId == uid()
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500;
        allow delete: if isAuth()
          && (resource.data.authorId == uid() || isAdmin());
      }
    }

    // ─── Likes ──────────────────────────────────────────────
    // Document ID pattern: {postId}_{userId} for ordinary likes
    // Only the owning user can create/delete their own likes
    match /likes/{likeId} {
      allow read: if isAuth();

      function ownEngagement() {
        return request.resource.data.userId == uid() &&
          request.resource.data.postId is string &&
          exists(/databases/$(database)/documents/posts/$(request.resource.data.postId)) &&
          ((likeId == request.resource.data.postId + '_' + uid() &&
            request.resource.data.keys().hasOnly(['postId', 'userId', 'createdAt'])) ||
           (likeId == request.resource.data.postId + '_rxn_' + uid() &&
            request.resource.data.keys().hasOnly(['postId', 'userId', 'emoji']) &&
            request.resource.data.emoji in ['😂', '🔥', '😮', '👏', '😢']));
      }
      allow create: if isAuth() && ownEngagement();
      allow update: if isAuth() && ownEngagement() &&
        resource.data.userId == uid() &&
        resource.data.postId == request.resource.data.postId;
      allow delete: if isAuth() && resource.data.userId == uid() &&
        (likeId == resource.data.postId + '_' + uid() ||
         likeId == resource.data.postId + '_rxn_' + uid());

      // ── Notifications: likeId starts with notif_ ──
      // Only the sender can create a notification (fromUid == auth.uid)
      allow create: if isAuth()
        && likeId.matches('^notif_.*')
        && !request.resource.data.keys().hasAny(['userId'])
        && request.resource.data.isNotification == true
        && request.resource.data.fromUid == uid();

      // Recipient can read/update/delete their own notifications
      allow update: if isAuth()
        && resource.data.isNotification == true
        && resource.data.notifToUid == uid()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['read']);

      allow delete: if isAuth()
        && resource.data.isNotification == true
        && resource.data.notifToUid == uid();

      // ── Story views: likeId = storyview_storyId_viewerId ──
      allow create: if isAuth()
        && likeId.matches('^storyview_.*')
        && !request.resource.data.keys().hasAny(['userId', 'emoji'])
        && request.resource.data.isStoryView == true
        && request.resource.data.viewerId == uid();

      // ── Calls: likeId = call_callId ──
      // Only the caller can create a call document
      allow create: if isAuth()
        && likeId.matches('^call_.*')
        && !request.resource.data.keys().hasAny(['userId', 'emoji'])
        && request.resource.data.isCall == true
        && request.resource.data.callerId == uid();

      // Caller or callee can update a call document
      allow update: if isAuth()
        && resource.data.isCall == true
        && (resource.data.callerId == uid() || resource.data.calleeId == uid())
        && !request.resource.data.keys().hasAny(['userId', 'emoji']);

      // Either party can delete/end a call
      allow delete: if isAuth()
        && resource.data.isCall == true
        && (resource.data.callerId == uid() || resource.data.calleeId == uid());
    }

    // ─── Follows ────────────────────────────────────────────
    // Document ID: {followerId}_{followeeId}
    match /follows/{followId} {
      allow read: if isAuth();

      // Only the follower (you) can create a follow document
      allow create: if isAuth()
        && request.resource.data.followerId == uid()
        && request.resource.data.followeeId is string
        && request.resource.data.followeeId != uid()
        && followId == uid() + '_' + request.resource.data.followeeId
        && request.resource.data.keys().hasOnly(['followerId', 'followeeId', 'createdAt'])
        && exists(/databases/$(database)/documents/users/$(request.resource.data.followeeId));

      // Only the follower can unfollow (delete)
      allow delete: if isAuth()
        && resource.data.followerId == uid();
    }

    // ─── Reports ────────────────────────────────────────────
    match /reports/{reportId} {
      allow read:   if isAdmin();
      allow create: if isAuth() && !isBanned()
        && request.resource.data.reportedBy == uid()
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0
        && request.resource.data.reason.size() <= 500;
      allow update: if isAdmin();
    }
  }
}
